# =============================================================================
# Shizuku Slice 1 — Environment Variables
# Copy to .env (gitignored) and fill in real values for local dev.
# Production values live in Railway / Vercel dashboards.
# All vars validated by packages/config (Zod) at startup.
# =============================================================================

# ---------- Shared ----------
NODE_ENV=development
LOG_LEVEL=debug

# ---------- Database (Postgres + pgvector) ----------
# Local dev: docker-compose.dev.yml runs pgvector on 5432
# Prod: Neon pooled DSN
DATABASE_URL=postgresql://shizuku:shizuku_dev@localhost:5432/shizuku
# Neon also requires a direct (non-pooled) URL for migrations
DATABASE_DIRECT_URL=postgresql://shizuku:shizuku_dev@localhost:5432/shizuku

# ---------- Auth ----------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_random_hex_for_dev_only_____________________
JWT_REFRESH_COOKIE_SECRET=replace_with_64_char_random_hex_for_dev_only_______
# Cookie domain (leave empty for localhost; set to .shizuku.app in prod)
COOKIE_DOMAIN=

# ---------- OAuth: Google ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to https://api.shizuku.app/v1/auth/google/callback in prod
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/auth/google/callback

# ---------- OAuth: Discord ----------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/v1/auth/discord/callback

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Cloudflare R2 ----------
# https://dash.cloudflare.com/<account>/r2
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shizuku-dev

# ---------- Email (Resend) ----------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Shizuku <hello@mail.shizuku.app>
RESEND_WEBHOOK_SECRET=

# ---------- Sentry (optional in dev) ----------
SENTRY_DSN=

# ---------- API service ----------
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# ---------- Web (Vite) — VITE_ prefix exposed to browser ----------
VITE_API_URL=http://localhost:3001
VITE_SENTRY_DSN=

# ---------- Cost guardrails ----------
# Override defaults for testing
COST_LIMIT_CHATS_PER_DAY=100
COST_LIMIT_PDFS_PER_USER=5
COST_LIMIT_PDF_MAX_BYTES=52428800

# ---------- Dev DNS workaround (LEAVE UNSET IN PRODUCTION) ----------
# When set, the DB client uses these DNS servers (instead of the system
# resolver) to resolve the DB hostname, and forces IPv4. Required when:
#   - systemd-resolved REFUSES the AWS/Neon hostname
#   - WSL2 doesn't recurse to public NS
#   - Corp DNS blocks AWS edge zones
# Example: DB_DNS_SERVERS=1.1.1.1,8.8.8.8
DB_DNS_SERVERS=
